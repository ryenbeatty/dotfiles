#!/usr/bin/env bash
#
# bootstrap installs things.
set -euo pipefail

cd "$(dirname "$0")/.."
DOTFILES_ROOT=$(pwd -P)
echo ''
info () {
  printf "\r  [ \033[00;34m..\033[0m ] $1\n"
}
user () {
  printf "\r  [ \033[0;33m??\033[0m ] $1\n"
}
success () {
  printf "\r\033[2K  [ \033[00;32mOK\033[0m ] $1\n"
}
fail () {
  printf "\r\033[2K  [\033[0;31mFAIL\033[0m] $1\n"
  echo ''
  exit 1
}
setup_gitconfig () {
  if ! [ -f git/gitconfig.local.symlink ]
  then
    if [ -f git/gitconfig.local.symlink.example ]; then
      info 'setup gitconfig'
      git_credential='cache'
      if [ "$(uname -s)" == "Darwin" ]
      then
        git_credential='osxkeychain'
      fi
      user ' - What is your github author name?'
      read -e git_authorname
      user ' - What is your github author email?'
      read -e git_authoremail
      sed -e "s/AUTHORNAME/$git_authorname/g" -e "s/AUTHOREMAIL/$git_authoremail/g" -e "s/GIT_CREDENTIAL_HELPER/$git_credential/g" git/gitconfig.local.symlink.example > git/gitconfig.local.symlink
      success 'gitconfig'
    else
      info 'gitconfig.local.symlink.example not found, skipping gitconfig setup'
    fi
  else
    success 'gitconfig already configured'
  fi
}
link_file () {
  local src=$1 dst=$2
  local overwrite= backup= skip=
  local action=
  if [ -f "$dst" -o -d "$dst" -o -L "$dst" ]
  then
    if [ "$overwrite_all" == "false" ] && [ "$backup_all" == "false" ] && [ "$skip_all" == "false" ]
    then
      local currentSrc="$(readlink $dst)"
      if [ "$currentSrc" == "$src" ]
      then
        skip=true;
      else
        user "File already exists: $dst ($(basename "$src")), what do you want to do?\n\
        [s]kip, [S]kip all, [o]verwrite, [O]verwrite all, [b]ackup, [B]ackup all?"
        read -n 1 action
        case "$action" in
          o )
            overwrite=true;;
          O )
            overwrite_all=true;;
          b )
            backup=true;;
          B )
            backup_all=true;;
          s )
            skip=true;;
          S )
            skip_all=true;;
          * )
            ;;
        esac
      fi
    fi
    overwrite=${overwrite:-$overwrite_all}
    backup=${backup:-$backup_all}
    skip=${skip:-$skip_all}
    if [ "$overwrite" == "true" ]
    then
      rm -rf "$dst"
      success "removed $dst"
    fi
    if [ "$backup" == "true" ]
    then
      mv "$dst" "${dst}.backup"
      success "moved $dst to ${dst}.backup"
    fi
    if [ "$skip" == "true" ]
    then
      success "skipped $src"
    fi
  fi
  if [ "$skip" != "true" ]  # "false" or empty
  then
    ln -s "$1" "$2"
    success "linked $1 to $2"
  fi
}
install_dotfiles () {
  info 'installing dotfiles'
  local overwrite_all=false backup_all=false skip_all=false
  for src in $(find -H "$DOTFILES_ROOT" -maxdepth 2 -name '*.symlink' -not -path '*.git*')
  do
    dst="$HOME/.$(basename "${src%.*}")"
    link_file "$src" "$dst"
  done
}
install_config_files () {
  info 'installing .config dotfiles'

  if [ ! -d "$HOME/.config" ]
  then
    mkdir -p "$HOME/.config"
    success "created $HOME/.config"
  fi

  if [ -d "$DOTFILES_ROOT/config" ]
  then
    local overwrite_all=false backup_all=false skip_all=false

    for src in "$DOTFILES_ROOT/config/"*/
    do
      src=${src%/}
      [ -e "$src" ] || continue

      # Each topic directory is symlinked whole, e.g.
      #   config/alacritty -> ~/.config/alacritty
      # so files added inside it are picked up without touching bootstrap.
      local config_name=$(basename "$src")
      link_file "$src" "$HOME/.config/$config_name"
    done
  else
    info 'no config directory found, skipping'
  fi
}
setup_gitconfig
install_dotfiles
install_config_files
install_pi_config () {
  info 'installing pi config'

  local pi_root="$DOTFILES_ROOT/pi/agent"
  local pi_home="$HOME/.pi/agent"
  if [ ! -d "$pi_root" ]
  then
    info 'no pi/agent directory found, skipping'
    return
  fi
  mkdir -p "$pi_home"

  local overwrite_all=false backup_all=false skip_all=false
  local src name dir

  # Top-level config files (settings.json, models.json, mcp.json, ...).
  for src in "$pi_root"/*.json
  do
    [ -e "$src" ] || continue
    link_file "$src" "$pi_home/$(basename "$src")"
  done

  # Extensions: link each child, not the directory, so pi (or you) can still
  # drop new extensions into ~/.pi/agent/extensions without them landing in
  # the repo. node_modules stays a real directory.
  for src in "$pi_root/extensions"/*
  do
    [ -e "$src" ] || continue
    link_file "$src" "$pi_home/extensions/$(basename "$src")"
  done

  # npm/ and mcp-servers/: manifests only. node_modules and .profile are
  # machine state and must not point into the repo.
  for src in "$pi_root"/npm/package*.json
  do
    [ -e "$src" ] || continue
    mkdir -p "$pi_home/npm"
    link_file "$src" "$pi_home/npm/$(basename "$src")"
  done
  for dir in "$pi_root"/mcp-servers/*/
  do
    [ -d "$dir" ] || continue
    name=$(basename "$dir")
    mkdir -p "$pi_home/mcp-servers/$name"
    for src in "${dir%/}"/package*.json
    do
      [ -e "$src" ] || continue
      link_file "$src" "$pi_home/mcp-servers/$name/$(basename "$src")"
    done
  done

  # Skills: link each skill directory, not skills/ itself, because pi also
  # installs skills that this repo does not track.
  if [ -d "$pi_root/skills" ]
  then
    for dir in "$pi_root"/skills/*/
    do
      [ -d "$dir" ] || continue
      link_file "${dir%/}" "$pi_home/skills/$(basename "$dir")"
    done
  fi

  success 'pi config links installed'
}
install_pi_config
install_skills () {
  info 'installing skills symlink'
  mkdir -p "$HOME/.agents"
  link_file "$DOTFILES_ROOT/skills" "$HOME/.agents/skills"
  # The skills installer ($HOME/.agents/.skill-lock.json) tracks provenance for
  # everything under skills/. Keep the versioned copy in sync so a fresh machine
  # knows where each skill came from.
  link_file "$DOTFILES_ROOT/skills/.skill-lock.json" "$HOME/.agents/.skill-lock.json"
  success 'skills symlink installed'
}
install_skills
# If we're on a Mac, let's install and setup homebrew.
if [ "$(uname -s)" == "Darwin" ]
then
  info "installing dependencies"
  if source bin/dot | while read -r data; do info "$data"; done
  then
    success "dependencies installed"
  else
    fail "error installing dependencies"
  fi
fi
echo ''
echo '  All installed!'
