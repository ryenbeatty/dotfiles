#!/usr/bin/env bash
#
# dot -- run every topic's installer, in dependency order.
#
# `script/install` owns the ordering (homebrew first, then the runtime topics);
# this wrapper is only the command you type and the help text attached to it.

set -euo pipefail

DOTFILES="$(cd "$(dirname "$0")/.." && pwd -P)"

usage () {
  cat <<EOF
dot -- dotfiles management

Usage: dot [options]

Options:
  -e, --edit    Open $DOTFILES in \$EDITOR
  -h, --help    Show this help message and exit

Installs/updates Homebrew + the Brewfile, then runs each topic's install.sh.
Idempotent: re-run it whenever you change a topic. It does not symlink files
into \$HOME -- that is script/bootstrap.
EOF
}

case ${1:-} in
  -h|--help) usage; exit 0 ;;
  -e|--edit) exec "$EDITOR" "$DOTFILES" ;;
  "") ;;
  *) echo "dot: unknown option: $1" >&2; usage >&2; exit 1 ;;
esac
(( $# <= 1 )) || { echo "dot: too many arguments" >&2; usage >&2; exit 1; }

exec "$DOTFILES/script/install"
