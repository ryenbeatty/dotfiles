# Global gitignore -- linked to ~/.gitignore by script/bootstrap, and pointed at
# from core.excludesFile in git/gitconfig.symlink.
#
# Keep this to editor/OS droppings and language-agnostic noise. Anything
# project-specific belongs in that project's own .gitignore.

# macOS
.DS_Store
.DS_Store?

# Editor and crash droppings
*~
*.swp
*.swo
.idea/

# Build output that leaks past project ignores
node_modules/
dist/
build/

# Local env files
.env
.env.local
.direnv/
