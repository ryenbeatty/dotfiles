# Local/private config goes in the include
[include]
        path = ~/.gitconfig.local
[alias]
        co = checkout
        sw = switch
        count   = !git shortlog -sn
[color]
        diff = auto
        status = auto
        branch = auto
        ui = true
[core]
        excludesfile = ~/.gitignore
        editor = nvim
[apply]
        whitespace = nowarn
[mergetool]
        keepBackup = false
[difftool]
        prompt = false
[push]
        # `autoSetupRemote` makes `git push` work on a branch with no upstream.
        default = simple
        autoSetupRemote = true
        followTags = true
[pull]
        rebase = true
[fetch]
        prune = true
        pruneTags = true
        all = true
[user]
        name = Ryen Beatty
        email = mail@ryenbeatty.info
	signingkey = 5CF61CA1FF8CBAB9
[credential]
        helper = osxkeychain
[diff]
        algorithm = histogram
        colorMoved = plain
        mnemonicPrefix = true
        renames = true
[rerere]
        enabled = true
        autoupdate = true
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[gpg]
	program = gpg
[commit]
	gpgsign = false
[init]
        defaultBranch = main
[branch]
        sort = -committerdate
[tag]
        sort = version:refname
