# tmux.conf -- linked to ~/.tmux.conf by script/bootstrap.

# --- plugins (tpm) -----------------------------------------------------------
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'
set -g @plugin 'christoomey/vim-tmux-navigator'
set -g @plugin 'egel/tmux-gruvbox'
set -g @tmux-gruvbox 'dark' # or 'dark256', 'light'

# Initialise tpm -- must stay the last line of this file.
run '~/.tmux/plugins/tpm/tpm'

# --- terminal ----------------------------------------------------------------
# tmux-256color carries the full 256-colour set; the old
# `terminal-overrides ",xterm*:Tc"` line is no longer needed now that every
# terminal in use advertises truecolor itself (tmux >= 3.2 reads it directly).
set -s default-terminal 'tmux-256color'

# Extended keys so pi (and vim) can tell Shift/Ctrl/Alt+Enter from plain Enter.
set -g extended-keys on
set -g extended-keys-format csi-u

# --- keys --------------------------------------------------------------------
# prefix is the stock C-b; no rebinding, so no commented-out block either.
bind -n M-H previous-window
bind -n M-L next-window
bind-key -r C-f run-shell "tmux neww tmux-sessionizer"

# vi keys in copy mode
setw -g mode-keys vi
