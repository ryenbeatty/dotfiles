printf "\e[?1042l"

export ZSH=$HOME/.dotfiles

# your project folder that we can `c [tab]` to
export PROJECTS=~/Code

# Stash your environment variables in ~/.localrc. This means they'll stay out
# of your main dotfiles repository (which may be public, like this one), but
# you'll have access to them in your scripts.
if [[ -a ~/.localrc ]]
then
  source ~/.localrc
fi

# all of our zsh files
typeset -U config_files
config_files=($ZSH/**/*.zsh)
# ...except vendored third-party plugins, which are sourced explicitly further
# down. Their tests/ and highlighters/ are *.zsh files too, and the glob used to
# execute them as if they were topic files.
config_files=(${config_files:#$ZSH/zsh/plugins/*})

# load the path files
for file in ${(M)config_files:#*/path.zsh}
do
  source $file
done

# load everything but the path and completion files
for file in ${${config_files:#*/path.zsh}:#*/completion.zsh}
do
  source $file
done

# initialize autocomplete here, otherwise functions won't be loaded
autoload -Uz compinit
ZCOMPDUMP="${ZDOTDIR:-$HOME}/.zcompdump"
if [[ -n ${ZDOTDIR:-$HOME}/.zcompdump(#qN.mh+24) ]]; then
  # missing or older than 24h: rebuild the dump and re-run the security audit
  compinit -d "$ZCOMPDUMP"
  # byte-compile it so subsequent shells load the table instead of parsing it
  zcompile "$ZCOMPDUMP" 2>/dev/null
else
  # fresh enough: trust the cache and skip the audit, which is a big part of
  # the startup cost. Regenerated automatically within a day.
  compinit -C -d "$ZCOMPDUMP"
fi
unset ZCOMPDUMP

# load every completion after autocomplete loads
for file in ${(M)config_files:#*/completion.zsh}
do
  source $file
done

unset config_files

# Better history
# Credits to https://coderwall.com/p/jpj_6q/zsh-better-history-searching-with-arrow-keys
# Guarded on a real terminal: `zsh -i -c` gets the `zle` option but no line
# editor, and `zle -N` there just prints "can't change option: zle".
autoload -U up-line-or-beginning-search
autoload -U down-line-or-beginning-search
if [[ -t 0 ]]; then
  zle -N up-line-or-beginning-search
  zle -N down-line-or-beginning-search
  bindkey "^[[A" up-line-or-beginning-search # Up
  bindkey "^[[B" down-line-or-beginning-search # Down
fi

# nvm is loaded lazily from nvm/path.zsh -- the eager load that used to live
# here defeated it and cost ~200ms of startup time.
export GPG_TTY=$(tty)


alias v="nvim"

# Set up fzf key bindings and fuzzy completion (if fzf is available).
# Guarded on `zle`: `fzf --zsh` binds keys, which fails in a shell without a
# line editor (e.g. `zsh -i -c exit`).
if [[ -t 0 ]] && command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh)
  # Bind Ctrl-F to tmux-sessionizer if it exists
  if command -v tmux-sessionizer >/dev/null 2>&1; then
    bindkey -s '^F' "tmux-sessionizer\n"
  fi
fi

# Plugin order is load-bearing:
#   1. fzf-tab -- replaces the completion *menu* with an fzf picker. It copies the
#      widget it wraps (grabbing `-> fzf-completion`, which `fzf --zsh` above just
#      bound to ^I, as its fallback), so it has to be sourced after `fzf --zsh`
#      and after compinit, but before anything else touches zle.
#   2. zsh-syntax-highlighting -- sourced last; its highlighters get clobbered by
#      any later zle setup, and fzf-tab's comment explicitly expects to run
#      before it.
# NOTE: zsh-autosuggestions was removed deliberately and its vendored copy is
# gone too: the grey text came from the shared *global* history, so it offered
# paths from directories you were not in, and the old TAB widget accepted that
# text before real completion ran. fzf-tab filters compsys candidates, which are
# always scoped to the command and the current directory.
_zsh_plugins="$ZSH/zsh/plugins"
if [[ -t 0 ]]; then
  if [[ -f $_zsh_plugins/fzf-tab/fzf-tab.plugin.zsh ]]; then
    source $_zsh_plugins/fzf-tab/fzf-tab.plugin.zsh
  fi
  if [[ -f $_zsh_plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
    source $_zsh_plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
  fi
fi
unset _zsh_plugins

# --- TAB ---------------------------------------------------------------------
# fzf-tab binds ^I itself (emacs and viins keymaps) when it is sourced above, so
# there is no widget to define here any more. TAB is now: fzf picker over the
# real candidates, falling back to fzf's `**` fuzzy path completion. Accepting a
# history suggestion on TAB disappeared with zsh-autosuggestions; → and End keep
# their stock line-editor meaning.

# fzf's file source: ripgrep, minus .git internals (--hidden on its own made the
# picker walk git's object store). `ag` was tried first but is not installed, and
# the rg branch overwrote it anyway.
if type rg &> /dev/null; then
    export FZF_DEFAULT_COMMAND='rg --files --hidden --glob "!.git/*"'
fi

if command -v wt >/dev/null 2>&1; then eval "$(command wt config shell init zsh)"; fi

# PATH entries live in system/_path.zsh, tool env vars in system/env.zsh,
# private keys in ~/.localrc, and aliases in zsh/aliases.zsh.
#
# NOTE: `cd` used to be redefined here to create/attach a tmux session whenever
# you entered a git repo (or a dir with package.json/Cargo.toml). That duplicated
# bin/tmux-sessionizer, which does it deliberately and is bound to C-f both here
# and in tmux. A `cd` that silently switches terminal multiplexers is a surprise
# in a core builtin, so it is gone: use the keybinding, or run tmux-sessionizer.
#
# bun's completions are sourced once, from bun/path.zsh (which uses $HOME rather
# than this machine's hardcoded /Users/ryenbeatty).
